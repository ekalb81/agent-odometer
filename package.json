{
  "name": "agent-odometer",
  "version": "0.8.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run && node --test scripts/validate-frontend-coverage.test.mjs scripts/tailwind-contract.test.mjs scripts/visual-impact.test.mjs scripts/visual-artifacts.test.mjs scripts/release-artifacts.test.mjs scripts/assemble-updater-manifest.test.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && node --test scripts/validate-frontend-coverage.test.mjs scripts/tailwind-contract.test.mjs scripts/visual-impact.test.mjs scripts/visual-artifacts.test.mjs scripts/release-artifacts.test.mjs scripts/assemble-updater-manifest.test.mjs && node scripts/validate-frontend-coverage.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:updater-manifest": "node --test scripts/validate-updater-manifest.test.mjs",
    "visual:test": "node scripts/validate-visual-baselines.mjs && playwright test",
    "visual:update": "node scripts/assert-visual-baseline-platform.mjs && playwright test --update-snapshots && node scripts/validate-visual-baselines.mjs",
    "visual:gallery": "node scripts/generate-visual-gallery.mjs",
    "visual:docs:update": "node scripts/generate-doc-screenshots.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "dompurify": "^3.4.12",
    "marked": "^18.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "svelte": "^5",
    "svelte-check": "^4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "license": "MIT"
}
